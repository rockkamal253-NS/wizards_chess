{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "THREE": "readonly",
    "Chess": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-redeclare": "error"
  }
}
