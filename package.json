{
  "name": "wizards-chess",
  "private": true,
  "scripts": {
    "serve": "node tests/static_server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint web/*.js",
    "test:visual": "node tests/visual_regression.mjs",
    "test:e2e": "node tests/e2e_flow.mjs",
    "test:all": "npm run lint && npm test && npm run test:visual && npm run test:e2e && python -m pytest tests -q"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
